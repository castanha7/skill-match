NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=substitua-por-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=2h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillmatch
DB_USER=skillmatch_app
DB_PASSWORD=configure-senha-forte
DB_CONNECTION_LIMIT=10
# Integração opcional: URL/APIs contratadas que devolvam resultados estruturados.
# Não use páginas de resultados de busca raspadas. Não coloque credenciais no frontend.
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_TOKEN=
# Ex.: Curitiba:PR,Araucaria:PR. Exige provedor configurado; agendamento opcional.
DISCOVERY_CITIES=
DISCOVERY_CRON=0 7 * * *
# Opcional: endpoint compatível com Chat Completions para feedback de entrevista.
# Configure somente no servidor; sem os três valores, /api/interviews/feedback responde 503.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
