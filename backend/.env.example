NODE_ENV=development
PORT=3000
# Abra o app em http://localhost:3000; mesma origem para frontend e API.
# Para frontend separado, liste as origens HTTPS exatas, separadas por vírgula e sem barra final.
FRONTEND_ORIGIN=http://localhost:3000
# 0 fora de proxy; use 1 apenas quando houver exatamente um proxy reverso confiável.
TRUST_PROXY=0

# Supabase > Project Settings > API. Configure valores reais apenas em backend/.env.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Project Settings > API Keys > Publishable key (a chave anon legada também é aceita).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA
# Project Settings > API Keys > Secret key (service_role legada também é aceita).
# Nunca publique, exponha no frontend nem envie por chat.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_PELA_CHAVE_PRIVADA
# URL exata autorizada em Supabase > Authentication > URL Configuration > Redirect URLs.
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000/auth-callback.html

# Opcional: provedor HTTPS compatível com Chat Completions. Credenciais ficam no servidor.
# Só é chamado após consentimento explícito do candidato; vazio = feedback IA desativado.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
