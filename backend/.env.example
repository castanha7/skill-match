NODE_ENV=development
PORT=3000
# Lista separada por vírgulas de origens EXATAS do frontend publicado (sem barra final).
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# Supabase > Project Settings > API. Todas estas credenciais ficam exclusivamente no servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave publishable/anon do Supabase (não é service-role; usada pelo servidor para Auth e requests públicos).
SUPABASE_ANON_KEY=sb_publishable_sua_chave_publica
# Segredo de servidor: nunca copie para HTML, JavaScript, repositório público ou navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sua_chave_privada
# URL exata autorizada em Supabase Authentication > URL Configuration > Redirect URLs.
AUTH_EMAIL_REDIRECT_URL=http://localhost:5173/auth-callback.html

# Opcional: provedor compatível com Chat Completions. Credenciais sempre no servidor.
# Feedback IA só é enviado com consentimento explícito por solicitação; sem config, a rota fica indisponível.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
