# O frontend estático não lê variáveis .env no navegador.
# Para ativar a API, configure a mesma URL em `content` da meta
# `skillmatch-api-base` nas páginas HTML (sem barra final, somente HTTPS em produção).
SKILLMATCH_API_BASE_URL=https://api.seudominio.com

# Supabase e IA são configurados exclusivamente em backend/.env, nunca aqui.
