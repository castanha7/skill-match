# Referência para o frontend estático; páginas HTML não carregam .env automaticamente.
# Ao servir frontend e API pela mesma origem no backend, não é necessário configurar URL.
# Para domínio separado, copie esta URL para a meta skillmatch-api-base nas páginas HTML.
SKILLMATCH_API_BASE_URL=https://api.seudominio.com

# As chaves Supabase pertencem apenas a backend/.env (veja backend/.env.example).
# Nunca inclua SUPABASE_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY no frontend.
